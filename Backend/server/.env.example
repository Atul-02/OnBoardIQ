PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/onboardiq

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# mock = reads data/case_02_extraction_mock_*.csv, ai = AI extractor (AI track)
EXTRACTION_PROVIDER=mock
EXTRACTION_TIMEOUT_MS=10000

# Key the backend uses to call the simulated services (extraction + core banking)
SERVICE_KEY=change-me-service-key
CORE_BANKING_URL=http://localhost:4000/mock/core-banking

# Uploaded document files are stored here (outside the database)
STORAGE_DIR=./storage/documents

# Password given to all seeded demo users
SEED_PASSWORD=Password@123

# How often the expiry job runs (cron syntax). Default: every hour.
EXPIRY_CRON=0 * * * *

# Gemini (AI track). Put the real key only in .env, never in code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
